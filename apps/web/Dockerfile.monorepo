# Next.js — contexto de build = RAIZ do monorepo (`app_de_direito/`).
# Coolify: Dockerfile = apps/web/Dockerfile.monorepo | Context = .
# Não define DOCKER_WEB_STANDALONE (usa outputFileTracingRoot na raiz do repo).

FROM node:20-bookworm-slim AS builder
WORKDIR /app

RUN apt-get update -y && apt-get install -y --no-install-recommends ca-certificates \
  && rm -rf /var/lib/apt/lists/*

ARG API_INTERNAL_URL=http://127.0.0.1:3001
ENV API_INTERNAL_URL=${API_INTERNAL_URL}

COPY package.json package-lock.json ./
COPY apps ./apps

RUN npm ci

ENV NEXT_TELEMETRY_DISABLED=1

RUN npm run build -w web

FROM node:20-bookworm-slim AS runner
WORKDIR /app

ARG API_INTERNAL_URL=http://127.0.0.1:3001
ENV API_INTERNAL_URL=${API_INTERNAL_URL}
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000
ENV HOSTNAME=0.0.0.0

COPY --from=builder /app/apps/web/.next/standalone ./
COPY --from=builder /app/apps/web/.next/static ./apps/web/.next/static
COPY --from=builder /app/apps/web/public ./apps/web/public

EXPOSE 3000

CMD ["node", "apps/web/server.js"]
