# Origem do NestJS (rewrite server-side — não expor em NEXT_PUBLIC_)
API_INTERNAL_URL=http://127.0.0.1:3001

# Prefixo usado pelo cliente (rewrite `/backend/*` → API em next.config). Outro host: `https://api.../api`
# Não deixe vazio: senão o browser chama `/auth/login` no Next e aparece "Cannot POST /auth/login".
NEXT_PUBLIC_API_BASE=/backend
