# Onde o **servidor** Next chama o Nest (BFF /api/bff). Obrigatório em produção Docker se NEXT_PUBLIC_* não existir no build.
# Ex.: http://nome-servico-api:3001  ou  https://api.seudominio.com  (sem path /api)
API_INTERNAL_URL=http://127.0.0.1:3001

# Prefixo usado pelo cliente (rewrite `/backend/*` → API em next.config). Outro host: `https://api.../api`
# Não deixe vazio: senão o browser chama `/auth/login` no Next e aparece "Cannot POST /auth/login".
# Em Coolify: pode ser só runtime; o BFF lê com acesso dinâmico para não ficar undefined no bundle.
NEXT_PUBLIC_API_BASE=/backend
