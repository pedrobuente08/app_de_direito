DATABASE_URL=postgresql://conectar:conectar@localhost:5432/conectar

JWT_SECRET=troque-por-string-longa-aleatoria-minimo-64-caracteres-recomendado
JWT_REFRESH_SECRET=outra-string-longa-diferente-da-anterior-minimo-64

JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

PORT=3001
NODE_ENV=development

CORS_ORIGINS=http://localhost:3000

# E-mail (recuperar senha — Nodemailer)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@exemplo.com
FRONTEND_PASSWORD_RESET_URL=http://localhost:3000/redefinir-senha

# Redis + BullMQ (fila de extração PDF assíncrona; opcional)
REDIS_URL=

# Supabase Storage (PDF temporário antes da fila; opcional)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=pdf-imports

# Superadmin da plataforma (JWT Bearer separado do tenant).
# Se PLATFORM_JWT_SECRET estiver vazio, a API sobe sem rotas /admin/* (útil em dev).
PLATFORM_JWT_SECRET=troque-por-segredo-diferente-do-JWT_SECRET
PLATFORM_BOOTSTRAP_SECRET=segredo-unico-para-primeiro-admin

# --- Comunica: `PATCH /config` (corpo JSON parcial; só admin) ---
# O merge grava em `escritorio.config`. Exemplo completo (cole no body do PATCH):
#
# {
#   "comunica_webhook_token": "segredo-compartilhado-com-o-comunica",
#   "comunica_regras": {
#     "INTIMAÇÃO": {
#       "criar_pendencia": true,
#       "tipo_pendencia": "MANIFESTAR",
#       "prazo_dias": 5
#     },
#     "AUDIÊNCIA DESIGNADA": {
#       "sincronizar_audiencia": true,
#       "audiencia_tipo": "UNA",
#       "audiencia_hora": "14:30"
#     }
#   },
#   "comunica_digest": {
#     "enabled": true,
#     "emails": ["coordenacao@escritorio.com.br"],
#     "dias": 1
#   }
# }
#
# Regras: chave = valor de `tipo` do webhook em MAIÚSCULAS.
# - criar_pendencia + tipo_pendencia (+ prazo_dias opcional) → cria pendência e preenche comunicacao.pendencia_gerada_id
# - sincronizar_audiencia → cria audiência (data = dataDisponibilizacao ou hoje; hora opcional HH:mm)
# Digest: cron diário ~7h; precisa SMTP_* + enabled + emails.

# Extração de PDF — microserviço Python em ../skill (OBRIGATÓRIO para upload PDF).
# 1) Na raiz do monorepo: python3 -m venv skill/.venv && source skill/.venv/bin/activate && pip install -r skill/requirements.txt
# 2) Terminal A: npm run dev:skill   (sobe FastAPI em :5001)
# 3) SKILL_URL deve apontar para esse host (sem / no final).
SKILL_URL=http://127.0.0.1:5001
# Opcional: se preencher na skill E aqui, o Nest envia X-Skill-Key (mesmo valor).
SKILL_API_KEY=

# --- Sentry (desativado no código; ver `src/instrument.ts` + `app.module.ts`) ---
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=development
# SENTRY_TRACES_SAMPLE_RATE=0.1
# SENTRY_SEND_DEFAULT_PII=false
